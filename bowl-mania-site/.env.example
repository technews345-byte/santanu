# Copy to .env and fill in. Never commit the real .env file.

# ---- Server ----
NODE_ENV=production
PORT=3000
# The public address customers use (used in tracking links and webhooks).
PUBLIC_URL=https://bowlmania.example.com
# Set to 1 when running behind Nginx/Caddy/a load balancer so client IPs are correct.
TRUST_PROXY=1
# Optional paths (defaults: ./data/bowl-mania.db and ./uploads)
# DATABASE_FILE=/var/lib/bowlmania/bowl-mania.db
# UPLOADS_DIR=/var/lib/bowlmania/uploads
# BACKUP_DIR=/var/backups/bowlmania
# Back up the database automatically every N hours (for hosts without cron, e.g. Railway). 0 = off.
# AUTO_BACKUP_HOURS=24
# On Railway, PUBLIC_URL, TRUST_PROXY and the data paths are set automatically from the
# service's domain and attached volume.

# ---- Security ----
# Long random string (at least 32 characters), e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, one is generated on first start and kept next to the database.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Overall API requests allowed per IP address per minute (sign-in, coupons and payments have tighter limits).
# API_RATE_LIMIT_PER_MIN=600

# ---- First Super Admin (only used when no staff account exists yet) ----
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Owner

# ---- Razorpay (Dashboard > Account & Settings > API Keys / Webhooks) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- WhatsApp Business Cloud API (Meta for Developers > WhatsApp > API Setup) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string; enter the same value as the webhook "Verify token" in Meta.
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings > Basic), used to check webhook signatures.
WHATSAPP_APP_SECRET=

# ---- Email for password resets (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bowl Mania <no-reply@example.com>"

# ---- Rider app push notifications (optional) ----
# Firebase service account JSON (one line) for Firebase Cloud Messaging. Without it the rider app
# still gets new deliveries by checking every 30 seconds while online.
FIREBASE_SERVICE_ACCOUNT=
