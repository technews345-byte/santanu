# Copy to .env. Mock mode works without a paid account.
MOTION_PROVIDER=mock
APP_ENV=development
APP_AUTH_TOKEN=
MEDIA_SIGNING_SECRET=replace-with-a-long-random-value
DATA_DIR=/data
DATABASE_URL=postgresql+psycopg://motion:motion@postgres:5432/motion
REDIS_URL=redis://redis:6379/0
FAL_KEY=
FAL_MODEL_STD=fal-ai/kling-video/v3/standard/motion-control
FAL_MODEL_PRO=fal-ai/kling-video/v3/pro/motion-control
PRICE_STD_PER_SECOND=0.126
PRICE_PRO_PER_SECOND=0.168
PUBLIC_API_BASE=http://localhost:8080
PUBLIC_WEBHOOK_URL=
ALLOWED_ORIGINS=
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=motion-studio
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=motionstudio
AWS_SECRET_ACCESS_KEY=local-dev-only-change-this
# For live fal, use publicly reachable S3/R2 and signed GET URLs; internal MinIO is local only.
SIGNED_URL_SECONDS=14400
USER_SPEND_CAP_USD=20
RETENTION_DAYS=30
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=104857600
MIN_IMAGE_DIMENSION=340
MAX_IMAGE_DIMENSION=3850
SEGMENT_HARD_CAP=28
SEGMENT_TIMEOUT_SECONDS=600
POLL_INTERVAL_SECONDS=2
MOCK_DELAY_SECONDS=6
FACE_MIN_PX=128
FACE_BLUR_THRESHOLD=70
FACE_MAX_YAW=45
FACE_SIMILARITY_THRESHOLD=0.45
FACE_SAMPLE_INTERVAL=0.5
FACE_MAX_SAMPLES=60
# Supply legally licensed ONNX files. The app never silently downloads model weights.
FACE_DETECTOR_ONNX=
FACE_EMBEDDING_ONNX=
FACE_MODEL_LICENSE_CONFIRMED=false
RVM_ONNX=
IDENTITY_CLAUSE_ENABLED=true
